USE_HANA=false
USE_DEV_FIXTURES=false
CONFIDENCE_THRESHOLD=0.40
RETRIEVAL_THRESHOLD=0.25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenRouter (recommended for this project)
OPENROUTER_API_KEY=put_your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Choose a model available to your OpenRouter account; examples can change over time.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=NyayaSetu

# Optional compatibility: if OPENROUTER_API_KEY is blank, these are used instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
